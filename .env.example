# Copy to .env and fill in real values. Never commit .env itself.

# --- Database (required) ---
DATABASE_URL="postgresql://user:pass@localhost:5432/eccd_db"
DIRECT_URL="postgresql://user:pass@localhost:5432/eccd_db"

# --- Security (required) ---
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<YOUR_JWT_SECRET>"
JWT_EXPIRES_IN="1d"

# --- CORS (required in production; requests are rejected without it) ---
CLIENT_ORIGIN="https://eccd-smart-track.vercel.app"

# --- Server ---
PORT=4000
NODE_ENV="development"
LOG_LEVEL="info"

# --- School timezone (IANA name) ---
# "Today" for attendance is computed in this zone, not the server's.
# Defaults to Asia/Manila if unset.
SCHOOL_TIMEZONE="Asia/Manila"

# --- Smart attendance: face + BLE verification (calibrate on real hardware!) ---
# Face match distance must be <= this (lower = stricter). Typical 0.45-0.55.
FACE_MAX_DISTANCE=0.5
# Runner-up student must be at least this much farther than the best match.
FACE_MIN_MARGIN=0.05
# Smoothed BLE RSSI (dBm) must be >= this (e.g. -70 ~ a few metres). Measure yours.
BLE_MIN_RSSI=-70
# Face and BLE must both have been seen within this many seconds.
VERIFY_WINDOW_SEC=30
# Sightings in a row each signal needs before it counts.
VERIFY_MIN_HITS=2

# --- Face recognition microservice (optional; see face-recognition-service/) ---
# Leave both unset to disable live face recognition. The key must match the
# service's RECOGNITION_SERVICE_KEY; generate with: openssl rand -hex 32
# RECOGNITION_SERVICE_URL="http://127.0.0.1:8001"
# On Railway, point at the face service's private address (plain http is
# accepted for *.railway.internal only), and reference the key so the two can't drift:
#   RECOGNITION_SERVICE_URL="http://${{face-recognition.RAILWAY_PRIVATE_DOMAIN}}:8001"
#   RECOGNITION_SERVICE_KEY="${{face-recognition.RECOGNITION_SERVICE_KEY}}"
# RECOGNITION_SERVICE_KEY="<YOUR_RECOGNITION_SERVICE_KEY>"

# --- Email (OTP delivery + arrival/departure notifications) ---
# Required in production (server refuses to start without these).
# Optional in development — if unset, emails are logged to the console instead.
#
# Using Resend: Resend exposes an SMTP relay, so no extra library/dependency
# is needed — verify eccdsmarttrack.app as a sending domain in Resend, then:
#   SMTP_HOST="smtp.resend.com"
#   SMTP_PORT=587
#   SMTP_USER="resend"
#   SMTP_PASS="<YOUR_RESEND_API_KEY>"
#   SMTP_FROM="\"ECCD SmartTrack\" <notifications@eccdsmarttrack.app>"
SMTP_HOST="<YOUR_SMTP_HOST>"
SMTP_PORT=587
SMTP_USER="<YOUR_SMTP_USER>"
SMTP_PASS="<YOUR_SMTP_PASS>"
SMTP_FROM="\"ECCD SmartTrack\" <noreply@school.com>"

# --- SMS (arrival/departure notifications via Semaphore, semaphore.co) ---
# Optional — entirely skipped (logged in dev) if unset; never blocks startup.
# Only delivers to Philippine mobile numbers.
# SEMAPHORE_API_KEY="<YOUR_SEMAPHORE_API_KEY>"
# Optional. Must be a sender name already registered/approved in your
# Semaphore account; omit to use your account's default.
# SEMAPHORE_SENDER_NAME="<YOUR_SEMAPHORE_SENDER_NAME>"

# --- SMS provider switch (temporary TextBee alternative, textbee.dev) ---
# "semaphore" (default) or "textbee". Only the selected provider is used, even
# if both keys are set. TextBee sends from an Android phone's SIM, so that
# phone must stay online with the TextBee app running. Still PH mobiles only.
# SMS_PROVIDER="semaphore"
# TEXTBEE_API_KEY="<YOUR_TEXTBEE_API_KEY>"
# Optional. Omit to use your account's default (or most recently active) device.
# TEXTBEE_DEVICE_ID="<YOUR_TEXTBEE_DEVICE_ID>"
# Optional. Only for a self-hosted TextBee; must be https in production.
# TEXTBEE_BASE_URL="https://api.textbee.dev/api/v1"

# --- Web Push (browser notifications for arrival/departure) ---
# Optional — push is skipped if unset; never blocks startup. Generate a key pair
# once with:  npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key is a SECRET (never commit
# it, and keep the same pair across deploys or every device must re-subscribe).
# VAPID_SUBJECT is a mailto: address or https:// URL the push services can
# contact you at. Requires the site to be served over https.
# VAPID_PUBLIC_KEY="<YOUR_VAPID_PUBLIC_KEY>"
# VAPID_PRIVATE_KEY="<YOUR_VAPID_PRIVATE_KEY>"
# VAPID_SUBJECT="mailto:<YOUR_CONTACT_EMAIL>"

# --- File storage ---
# "local" (default) keeps uploads in ./uploads — fine for development or a
# single server. "s3" uses any S3-compatible bucket. Pick ONE of the two
# s3 configurations below; switching between them is only these variables.
STORAGE_DRIVER="local"

# (a) Neon Object Storage — `neon deploy` / `neon env pull` writes the AWS_* values.
#   STORAGE_DRIVER="s3"
#   S3_BUCKET="<YOUR_BUCKET_NAME>"
#   AWS_REGION="ap-southeast-1"
#   AWS_ENDPOINT_URL_S3="<YOUR_NEON_BRANCH_S3_ENDPOINT>"
#   AWS_ACCESS_KEY_ID="<YOUR_NEON_ACCESS_KEY_ID>"
#   AWS_SECRET_ACCESS_KEY="<YOUR_NEON_SECRET_ACCESS_KEY>"
#
# (b) AWS S3 — no endpoint. On AWS prefer an IAM role (ECS/EC2/EKS) and leave
# the two key variables unset; the SDK finds the role's credentials itself.
#   STORAGE_DRIVER="s3"
#   S3_BUCKET="<YOUR_BUCKET_NAME>"
#   AWS_REGION="ap-southeast-1"
#
# Optional. Defaults to true when AWS_ENDPOINT_URL_S3 is set, false otherwise.
# S3_FORCE_PATH_STYLE=""

# --- Redis (optional) ---
# Enables distributed rate limiting across multiple server instances.
# Without it, rate limits are tracked in-memory per instance (fine for a
# single instance, not for a load-balanced deployment).
REDIS_URL=""

# --- Seeding ---
# Used only by `node seed.js`. If unset, a random password is generated
# and printed once.
ADMIN_SEED_PASSWORD=""
# Optional — defaults to admin@school.com if unset.
ADMIN_SEED_EMAIL=""
