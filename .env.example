# Copy to .env and fill in real values. Never commit .env itself.

# --- Database (required) ---
DATABASE_URL="postgresql://user:pass@localhost:5432/eccd_db"
DIRECT_URL="postgresql://user:pass@localhost:5432/eccd_db"

# --- Security (required) ---
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<YOUR_JWT_SECRET>"
JWT_EXPIRES_IN="1d"

# --- CORS (required in production; requests are rejected without it) ---
CLIENT_ORIGIN="https://eccd-smart-track.vercel.app"

# --- Server ---
PORT=4000
NODE_ENV="development"
LOG_LEVEL="info"

# --- Email (OTP delivery) ---
# Required in production (server refuses to start without these).
# Optional in development — if unset, OTPs are logged to the console instead.
SMTP_HOST="<YOUR_SMTP_HOST>"
SMTP_PORT=587
SMTP_USER="<YOUR_SMTP_USER>"
SMTP_PASS="<YOUR_SMTP_PASS>"
SMTP_FROM="\"ECCD SmartTrack\" <noreply@school.com>"

# --- Redis (optional) ---
# Enables distributed rate limiting across multiple server instances.
# Without it, rate limits are tracked in-memory per instance (fine for a
# single instance, not for a load-balanced deployment).
REDIS_URL=""

# --- Seeding ---
# Used only by `node seed.js`. If unset, a random password is generated
# and printed once.
ADMIN_SEED_PASSWORD=""
# Optional — defaults to admin@school.com if unset.
ADMIN_SEED_EMAIL=""
