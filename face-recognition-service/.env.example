# Copy to .env (never commit it). Loaded by your process manager or `export`.

# REQUIRED. Shared secret the backend sends in X-Service-Key. The service refuses
# to start without it. Must match the backend's RECOGNITION_SERVICE_KEY.
# Generate with: openssl rand -hex 32
RECOGNITION_SERVICE_KEY="<YOUR_RECOGNITION_SERVICE_KEY>"

# Folder of enrolled faces: Images/<numeric studentId>/<photo>.jpg
KNOWN_FACES_DIR="./Images"
