generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  Teacher
  Parent
  Guardian
  Admin
}

enum AttendanceStatus {
  present
  absent
  excused
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(Parent)
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  children     ParentChild[]

  @@map("users")
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_otps")
}

enum Session {
  morning
  afternoon
}

enum StudentStatus {
  active
  inactive
}

model Student {
  id        Int      @id @default(autoincrement())

  firstName  String
  middleName String?
  lastName   String
  suffix     String?
  // Denormalized full name, kept in sync server-side on create/update.
  // Exists because list/dashboard views (StudentTable, EventCard, search)
  // consume a single "name" string, while the edit form needs the parts.
  name       String

  photo     String?
  birthday  DateTime      @db.Date
  address   String
  session   Session       @default(morning)
  status    StudentStatus @default(active)

  motherName    String?
  motherAddress String?
  motherPhone   String?
  motherEmail   String?

  fatherName    String?
  fatherAddress String?
  fatherPhone   String?
  fatherEmail   String?

  guardianName    String
  guardianAddress String?
  guardianPhone   String
  guardianEmail   String?

  allergies    String?
  dietary      String?
  specialNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parents     ParentChild[]
  attendance  Attendance[]
  submissions Submission[]
  documents   StudentDocument[]

  @@map("students")
}

model StudentDocument {
  id         Int      @id @default(autoincrement())
  studentId  Int
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_documents")
}

model ParentChild {
  id        Int     @id @default(autoincrement())
  parentId  Int
  studentId Int
  parent    User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_children")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@map("attendance")
}

model Album {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   @default("Uncategorized")
  description String?
  createdAt   DateTime @default(now())

  photos      Photo[]

  @@map("albums")
}

model Photo {
  id        Int      @id @default(autoincrement())
  albumId   Int
  fileUrl   String
  caption   String?
  createdAt DateTime @default(now())

  album     Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Material {
  id          Int      @id @default(autoincrement())
  title       String
  category    String?
  description String?
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@map("materials")
}

model Submission {
  id          Int      @id @default(autoincrement())
  materialId  Int
  studentId   Int
  fileUrl     String
  fileName    String
  submittedAt DateTime @default(now())

  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

enum EventCategory {
  Holiday
  Birthday
  Others
}

model Event {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  date        DateTime      @db.Date
  category    EventCategory @default(Others)
  createdAt   DateTime      @default(now())

  @@map("events")
}

model DailyTheme {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  letter      String
  label       String
  subtitle    String?
  title       String
  description String?
  objectives  String[]
  createdAt   DateTime @default(now())

  @@map("daily_themes")
}
